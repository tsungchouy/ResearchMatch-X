# Copy to backend/.env and fill in. Never commit the real file.
OPENAI_API_KEY=
# Must be a model your account can use with the built-in web_search tool.
OPENAI_MODEL=
# Optional for supported reasoning models. "low" reduces latency and token use.
OPENAI_REASONING_EFFORT=low

# Optional
# OPENAI_TIMEOUT_SECONDS=180
# Only for local testing against a stub server or a proxy.
# OPENAI_BASE_URL=
# Only when the frontend is served from a different origin, e.g. https://researchmatch.example.edu
# CORS_ORIGINS=
